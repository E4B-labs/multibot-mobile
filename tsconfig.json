{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // `logic.test.ts` chodzi pod runnerem Node'a, ktory wymaga rozszerzenia w
    // imporcie — bez tego `tsc --noEmit` na tym projekcie nie przechodzi wcale.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // `webui/` to osobny projekt webowy z własnym tsconfigiem, własnymi
  // zależnościami i własnym aliasem `@/`. Sprawdzany komendą `npm run typecheck`
  // wykonaną w tamtym katalogu. Bez tego wyłączenia sprawdzenie skorupy tonie
  // w kilkuset błędach o nieznalezionych modułach interfejsu.
  "exclude": ["node_modules", "webui", "android", "ios"]
}
