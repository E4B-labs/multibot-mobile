# Keep generated output reproducible across Windows and POSIX runners. Without
# explicit eol rules, core.autocrlf changes WebView source before Vite bundles it.
* text=auto
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
