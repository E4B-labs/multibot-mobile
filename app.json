{
  "expo": {
    "name": "MultiBot Mobile",
    "slug": "multibot2-mobile",
    "scheme": "multibot",
    "version": "0.5.0",
    "runtimeVersion": "1.6.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070707",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.multibot2.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo to attach it to a message."
      }
    },
    "android": {
      "package": "com.multibot2.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to take a photo for a message."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-notifications",
      "./plugins/with-tls-pinning.js"
    ],
    "extra": {
      "eas": {
        "projectId": "ddb5cfa5-d72e-419f-acb7-e7c2dcddce14"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ddb5cfa5-d72e-419f-acb7-e7c2dcddce14"
    },
    "icon": "./assets/icon.png"
  }
}
