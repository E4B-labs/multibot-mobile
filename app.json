{
  "expo": {
    "name": "MultiBot",
    "slug": "multibot-app-mobile",
    "scheme": "multibot",
    "version": "0.13.0",
    "runtimeVersion": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070707",
    "android": {
      "package": "com.e4blabs.multibotapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to take a photo for a message."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-notifications",
      "./plugins/with-tls-pinning.js"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.e4blabs.multibotapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo to attach it to a message."
      }
    }
  }
}