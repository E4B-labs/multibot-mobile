{
  "expo": {
    "name": "MultiBot",
    "slug": "multibot-mobile",
    "scheme": "multibot",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070707",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openmausbot.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan a QR code to pair with your MultiBot host.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.openmausbot.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to scan a MultiBot pairing QR code."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "1d7db8a3-befe-4dc3-a347-293d98c0d031"
      }
    },
    "owner": "slafy",
    "updates": {
      "url": "https://u.expo.dev/1d7db8a3-befe-4dc3-a347-293d98c0d031"
    }
  }
}
