{
  "name": "multibot2-mobile",
  "description": "MultiBot Mobile — pair with a host, then show its full web UI in a WebView.",
  "private": true,
  "version": "0.3.9",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/logic.test.ts src/lib/onboarding-flow.test.ts",
    "test:webui": "npm --prefix webui run test",
    "webui": "npm --prefix webui run build && node scripts/bundle-webui.mjs",
    "sync-webui": "node scripts/sync-webui.mjs"
  },
  "dependencies": {
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.0",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-intent-launcher": "~13.0.8",
    "expo-notifications": "~0.32.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
